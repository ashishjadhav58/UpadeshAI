GROQ_MODEL=allam-2-7b
GROQ_REWRITE_MODEL=allam-2-7b

# Minimum cosine similarity (0–1) for retrieved verses to enter LLM context
SIMILARITY_THRESHOLD=0.62

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=upadeshaI

